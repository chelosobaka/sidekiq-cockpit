<div class="small mt-1">
  <code><%= schedule.cron %></code>
  <% if schedule.enabled? %>
    <% if schedule.next_run_at %>
      <div><%= t('sidekiq_jobs_displayer.next_run', time: sjd_time(schedule.next_run_at)) %></div>
    <% end %>
  <% else %>
    <div class="text-danger"><%= t('sidekiq_jobs_displayer.disabled') %></div>
  <% end %>
</div>
