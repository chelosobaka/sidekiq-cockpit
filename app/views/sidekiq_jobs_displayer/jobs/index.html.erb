<header class="d-flex flex-wrap align-items-end gap-3 mb-4">
  <div class="me-auto">
    <h1 class="h3"><%= t('.title') %></h1>
    <p class="text-body-secondary mb-0"><%= t('.intro', limit: sjd_config.history.limit) %></p>
  </div>
  <%= form_with url: jobs_path, method: :get, class: 'd-flex align-items-center gap-3' do %>
    <% groups = @overview.rows.filter_map(&:group).uniq.sort %>
    <% if groups.any? || @group %>
      <%= select_tag :group, options_for_select(groups, @group), include_blank: t('.all_groups'),
                     class: 'form-select form-select-sm', onchange: 'this.form.requestSubmit()' %>
    <% end %>
    <div class="form-check text-nowrap mb-0">
      <%= check_box_tag :failed, '1', @failed_only, class: 'form-check-input', onchange: 'this.form.requestSubmit()' %>
      <%= label_tag :failed, t('.failed_only'), class: 'form-check-label' %>
    </div>
  <% end %>
</header>

<% if @overview.empty? %>
  <p class="text-body-secondary"><%= t('.empty') %></p>
<% end %>

<% { 'scheduled' => @overview.scheduled, 'events' => @overview.events }.each do |section, rows| %>
  <% next if rows.empty? %>
  <section class="mb-5">
    <h2 class="h5"><%= t(".sections.#{section}") %></h2>
    <%= render 'rows', rows: rows, capabilities: @overview.capabilities %>
  </section>
<% end %>
