<div class="table-responsive">
  <table class="table table-striped table-hover align-top">
    <thead>
      <tr>
        <th><%= t('sidekiq_cockpit.columns.job') %></th>
        <th><%= t('sidekiq_cockpit.columns.when') %></th>
        <th><%= t('sidekiq_cockpit.columns.last_run') %></th>
        <th><%= t('sidekiq_cockpit.columns.result') %></th>
        <th><%= t('sidekiq_cockpit.columns.day') %></th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% rows.each do |row| %>
        <% run = row.last_run %>
        <tr>
          <td>
            <%= link_to tag.strong(row.name), job_path(row.name), class: 'link-body-emphasis text-decoration-none' %>
            <% if row.group %><span class="badge text-bg-light border ms-1"><%= row.group %></span><% end %>
            <div class="small text-body-secondary"><%= row.description %></div>
          </td>
          <td>
            <%= row.trigger %>
            <% row.schedules.each do |schedule| %>
              <%= render 'sidekiq_cockpit/schedules/schedule', schedule: schedule %>
            <% end %>
          </td>
          <td class="text-nowrap">
            <% if run %>
              <%= cockpit_time(run.started_at) %>
              <div class="small text-body-secondary"><%= cockpit_duration(run.duration) %></div>
            <% else %>
              <span class="text-body-secondary"><%= t('sidekiq_cockpit.never_run') %></span>
            <% end %>
          </td>
          <td><%= cockpit_result(run) if run %></td>
          <td class="text-nowrap">
            <%= cockpit_day_runs(row.day_stats) %>
            <% if row.day_stats.failed.positive? %>
              <div class="small text-danger"><%= t('sidekiq_cockpit.day_failures', failures: row.day_stats.failed) %></div>
            <% end %>
          </td>
          <td class="text-end">
            <% row.schedules.each do |schedule| %>
              <%= render 'sidekiq_cockpit/schedules/buttons', schedule: schedule, capabilities: capabilities %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
