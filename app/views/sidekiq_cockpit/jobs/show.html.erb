<%# Страница задачи: описание, расписания, последние запуски. %>
<p><a href="<%= jobs_path %>" <%# class="link-secondary" %>><%= t('.back') %></a></p>

<header <%# class="mb-4" %>>
  <h1 <%# class="h3 mb-1" %>>
    <%= @job.name %>
    <% if @job.group %>
      <span data-group <%# class="badge text-bg-light border fs-6 align-middle" %>><%= @job.group %></span>
    <% end %>
  </h1>
  <div <%# class="text-body-secondary" %>><%= @job.description %></div>
  <% if @job.trigger.present? %>
    <div <%# class="mt-1" %>><%= @job.trigger %></div>
  <% end %>
  <div <%# class="mt-2" %>>
    <%= t('sidekiq_cockpit.day_runs', runs: @job.day_stats.total) %>
    <% if @job.day_stats.failed.positive? %>
      <span <%# class="text-danger ms-2" %>><%= t('sidekiq_cockpit.day_failures', failures: @job.day_stats.failed) %></span>
    <% end %>
    <% if @job.day_stats.average_duration %>
      <span <%# class="text-body-secondary ms-2" %>><%= t('.average', duration: cockpit_duration(@job.day_stats.average_duration)) %></span>
    <% end %>
  </div>
</header>

<% if @job.scheduled? %>
  <section <%# class="mb-4" %>>
    <h2 <%# class="h5" %>><%= t('.schedules') %></h2>
    <ul <%# class="list-group" %>>
      <% @job.schedules.each do |schedule| %>
        <li <%# class="list-group-item d-flex flex-wrap align-items-start gap-3" %>>
          <div <%# class="me-auto" %>>
            <strong><%= schedule.id %></strong>
            <%= render 'sidekiq_cockpit/schedules/schedule', schedule: schedule %>
          </div>
          <%= render 'sidekiq_cockpit/schedules/buttons', schedule: schedule, capabilities: @job.capabilities %>
        </li>
      <% end %>
    </ul>
  </section>
<% end %>

<section>
  <h2 <%# class="h5" %>><%= t('.runs') %></h2>
  <% if @job.runs.empty? %>
    <p <%# class="text-body-secondary" %>><%= t('.no_runs') %></p>
  <% else %>
    <div <%# class="table-responsive" %>>
      <table <%# class="table table-striped table-sm align-top" %>>
        <thead>
          <tr>
            <th><%= t('sidekiq_cockpit.columns.started_at') %></th>
            <th><%= t('sidekiq_cockpit.columns.duration') %></th>
            <th><%= t('sidekiq_cockpit.columns.queue') %></th>
            <th><%= t('sidekiq_cockpit.columns.result') %></th>
            <th><%= t('sidekiq_cockpit.columns.args') %></th>
          </tr>
        </thead>
        <tbody>
          <% @job.runs.each do |run| %>
            <tr data-jid="<%= run.jid %>">
              <td <%# class="text-nowrap" %>><%= cockpit_time(run.started_at) %></td>
              <td <%# class="text-nowrap" %>><%= cockpit_duration(run.duration) %></td>
              <td><%= run.queue %></td>
              <td><%= render 'sidekiq_cockpit/runs/result', run: run %></td>
              <td><code <%# class="small text-break" %>><%= run.args %></code></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
