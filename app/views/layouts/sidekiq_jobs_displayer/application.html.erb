<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-bs-theme="light">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= sjd_config.title %></title>
  <%= csrf_meta_tags %>
  <script>
    // Тема Bootstrap 5.3 — как в системе пользователя.
    if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
      document.documentElement.setAttribute('data-bs-theme', 'dark');
    }
  </script>
  <% if sjd_config.bootstrap_css_url %>
    <%= stylesheet_link_tag SidekiqJobsDisplayer.config.bootstrap_css_url %>
  <% end %>
</head>
<body>
  <nav class="navbar navbar-expand bg-body-tertiary border-bottom mb-4">
    <div class="container-fluid">
      <%= link_to SidekiqJobsDisplayer.config.title, root_path, class: 'navbar-brand' %>
      <ul class="navbar-nav me-auto">
        <li class="nav-item">
          <%= link_to t('sidekiq_jobs_displayer.nav.jobs'), root_path,
                      class: ['nav-link', ('active' if controller_name == 'jobs')] %>
        </li>
      </ul>
      <% if sjd_config.back_url %>
        <%= link_to t('sidekiq_jobs_displayer.nav.back'), sjd_config.back_url,
                    class: 'btn btn-outline-secondary btn-sm' %>
      <% end %>
    </div>
  </nav>

  <main class="container-xxl">
    <% flash.each do |type, message| %>
      <div class="alert alert-<%= type.to_s == 'alert' ? 'danger' : 'success' %>"><%= message %></div>
    <% end %>
    <%= yield %>
  </main>

  <% if sjd_config.bootstrap_js_url %>
    <%= javascript_include_tag SidekiqJobsDisplayer.config.bootstrap_js_url %>
  <% end %>
</body>
</html>
